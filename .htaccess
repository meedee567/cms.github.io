# =============================================================================
# สำหรับกรณีวางโฟลเดอร์ ./out บน static hosting (Apache / cPanel)
# =============================================================================
#
# ⚠️ อ่านก่อนใช้
# --------------
# ไฟล์ชุดนี้เป็น "หน้าเว็บอย่างเดียว" ไม่มี API และไม่มี webhook อยู่ในนี้
# ระบบจะทำงานได้ก็ต่อเมื่อมี Bun server รันอยู่ที่ไหนสักแห่ง แล้วตั้งค่า
# API_URL ใน config.js ให้ชี้ไปที่นั่น
#
# กฎด้านล่างจงใจ "ไม่" เขียน /api/ กับ /webhook กลับไปที่ index.html
# เหตุผล: ของเดิมเขียนทุกอย่างกลับไปที่ index.html ทำให้ request ที่ยิงผิดที่
# ได้ HTML กลับมาพร้อมสถานะ 200 หน้าเว็บจึงเข้าใจว่า "สำเร็จ" ทั้งที่ไม่มี
# อะไรเกิดขึ้นเลย — เป็นบั๊กที่ไล่หาสาเหตุยากที่สุดตัวหนึ่งของระบบนี้
# ปล่อยให้เป็น 404 ชัด ๆ ดีกว่า

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /api/* และ /webhook ไม่ใช่ของหน้าเว็บชุดนี้ — ต้องตอบ 404 ให้เห็นชัด
  RewriteRule ^api/ - [R=404,L]
  RewriteRule ^webhook$ - [R=404,L]

  # ไฟล์และโฟลเดอร์ที่มีอยู่จริง เสิร์ฟตรง ๆ
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ไฟล์ที่มีนามสกุลแล้วหาไม่เจอ = 404 จริง ห้ามคืน index.html
  # (ไม่งั้นเบราว์เซอร์จะพยายามรัน HTML เป็น JavaScript แล้วขึ้น error ที่เดาต้นตอไม่ได้)
  RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]+$
  RewriteRule ^ - [R=404,L]

  # ที่เหลือคือเส้นทางของหน้าเว็บ → ส่งให้ index.html จัดการ
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # config.js ต้องไม่ถูกแคช ไม่งั้นแก้ค่าแล้วผู้ใช้ยังเห็นของเดิม
  <Files "config.js">
    Header set Cache-Control "no-store, must-revalidate"
  </Files>
</IfModule>
